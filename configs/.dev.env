# Development settings for the dev server's identity provider (deps.dev.yaml), shared by the
# containers and the server. Development-only values.
DEV_SSO_PASSWORD=mage-dev-password

OIDC_CLIENT_ID=mage
OIDC_CLIENT_SECRET=mage-development-oidc-client-secret
OIDC_NAME=Authentik
SCIM_TOKEN=mage-development-scim-token-0123456789
